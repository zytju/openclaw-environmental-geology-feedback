{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eg:feedback:1.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "student_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "pattern": "^S[0-9]{3}$"
    },
    "case_id": {
      "const": "shuping-teaching-v1"
    },
    "submission_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "requires_teacher_signoff": {
      "const": true
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "enum": [
              "problem_identification",
              "evidence_extraction",
              "reasoning_chain",
              "hazard_chain",
              "uncertainty",
              "mitigation_match"
            ]
          },
          "assessment": {
            "enum": [
              "supported",
              "partial",
              "absent",
              "needs_teacher",
              "not_in_scope"
            ]
          },
          "level_proposal": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              {
                "type": "null"
              }
            ]
          },
          "anchor": {
            "type": "object",
            "properties": {
              "paragraph_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 8,
                "pattern": "^(P[0-9]{2,6}|REPORT)$"
              },
              "quote": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "paragraph_id",
              "quote"
            ],
            "additionalProperties": false
          },
          "evidence_card_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 20
            },
            "minItems": 0,
            "maxItems": 30,
            "uniqueItems": true
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim_id": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 40
                },
                "source_id": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 40
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "required": [
                "claim_id",
                "source_id",
                "locator"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 6
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 350
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "issue_id": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 20,
                  "pattern": "^I[0-9]{2,6}$"
                },
                "severity": {
                  "enum": [
                    "major",
                    "minor",
                    "teacher_check"
                  ]
                },
                "anchor": {
                  "type": "object",
                  "properties": {
                    "paragraph_id": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 8,
                      "pattern": "^(P[0-9]{2,6}|REPORT)$"
                    },
                    "quote": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "paragraph_id",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "evidence_card_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 20
                  },
                  "minItems": 0,
                  "maxItems": 30,
                  "uniqueItems": true
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim_id": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 40
                      },
                      "source_id": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 40
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    },
                    "required": [
                      "claim_id",
                      "source_id",
                      "locator"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 6
                },
                "problem": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "revision_action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                },
                "check_question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "uncertainty": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "issue_id",
                "severity",
                "anchor",
                "evidence_card_ids",
                "citations",
                "problem",
                "rationale",
                "revision_action",
                "check_question",
                "uncertainty"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 3
          }
        },
        "required": [
          "dimension",
          "assessment",
          "level_proposal",
          "anchor",
          "evidence_card_ids",
          "citations",
          "basis",
          "issues"
        ],
        "additionalProperties": false
      },
      "minItems": 6,
      "maxItems": 6
    },
    "boundary_reminder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 350
    }
  },
  "required": [
    "schema_version",
    "student_id",
    "case_id",
    "submission_sha256",
    "requires_teacher_signoff",
    "dimensions",
    "boundary_reminder"
  ],
  "additionalProperties": false
}
