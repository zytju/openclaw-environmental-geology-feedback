{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eg:release:1.1.0",
  "type": "object",
  "properties": {
    "release_version": {
      "const": "1.1.0"
    },
    "student_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "pattern": "^S[0-9]{3}$"
    },
    "is_simulated": {
      "type": "boolean"
    },
    "final_record_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "released_issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 20,
        "pattern": "^I[0-9]{2,6}$"
      },
      "minItems": 0,
      "maxItems": 60,
      "uniqueItems": true
    },
    "issues": {
      "type": "array",
      "minItems": 0,
      "maxItems": 18,
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "enum": [
              "problem_identification",
              "evidence_extraction",
              "reasoning_chain",
              "hazard_chain",
              "uncertainty",
              "mitigation_match"
            ]
          },
          "issue": {
            "type": "object",
            "properties": {
              "issue_id": {
                "type": "string",
                "minLength": 2,
                "maxLength": 20,
                "pattern": "^I[0-9]{2,6}$"
              },
              "severity": {
                "enum": [
                  "major",
                  "minor"
                ]
              },
              "anchor": {
                "type": "object",
                "properties": {
                  "paragraph_id": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 8,
                    "pattern": "^(P[0-9]{2,6}|REPORT)$"
                  },
                  "quote": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "paragraph_id",
                  "quote"
                ],
                "additionalProperties": false
              },
              "evidence_card_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 20
                },
                "minItems": 0,
                "maxItems": 30,
                "uniqueItems": true
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "claim_id": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 40
                    },
                    "source_id": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 40
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "required": [
                    "claim_id",
                    "source_id",
                    "locator"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 6
              },
              "problem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "revision_action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "check_question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uncertainty": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "issue_id",
              "severity",
              "anchor",
              "evidence_card_ids",
              "citations",
              "problem",
              "rationale",
              "revision_action",
              "check_question",
              "uncertainty"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "dimension",
          "issue"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "release_version",
    "student_id",
    "is_simulated",
    "final_record_sha256",
    "released_issue_ids",
    "issues"
  ],
  "additionalProperties": false
}
