{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eg:submission:1.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "student_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "pattern": "^S[0-9]{3}$"
    },
    "case_id": {
      "const": "shuping-teaching-v1"
    },
    "material_kind": {
      "enum": [
        "synthetic",
        "student_work"
      ]
    },
    "stage": {
      "enum": [
        "draft",
        "revision"
      ]
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paragraph_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 8,
            "pattern": "^P[0-9]{2,6}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "required": [
          "paragraph_id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 40
    },
    "raw_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 20,
            "pattern": "^A[0-9]+$"
          },
          "kind": {
            "enum": [
              "notes",
              "sketch_transcript"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 20,
            "maxLength": 6000
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "content"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10
    },
    "evidence_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 20,
            "pattern": "^E[0-9]+$"
          },
          "source_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "excerpt_type": {
            "enum": [
              "paraphrase",
              "short_quote",
              "simulation"
            ]
          },
          "excerpt": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1500
          },
          "interpretation": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1500
          },
          "paragraph_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 8,
              "pattern": "^P[0-9]{2,6}$"
            },
            "minItems": 1,
            "maxItems": 40,
            "uniqueItems": true
          }
        },
        "required": [
          "card_id",
          "source_id",
          "locator",
          "excerpt_type",
          "excerpt",
          "interpretation",
          "paragraph_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "previous_issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 20,
        "pattern": "^I[0-9]{2,6}$"
      },
      "minItems": 0,
      "maxItems": 60,
      "uniqueItems": true
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feedback_issue_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 20,
            "pattern": "^I[0-9]{2,6}$"
          },
          "paragraph_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 8,
            "pattern": "^P[0-9]{2,6}$"
          },
          "decision": {
            "enum": [
              "adopt",
              "partly_adopt",
              "reject"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        },
        "required": [
          "feedback_issue_id",
          "paragraph_id",
          "decision",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 60
    },
    "report_scope": {
      "enum": [
        "full_report",
        "excerpt"
      ]
    },
    "assessed_dimensions": {
      "type": "array",
      "items": {
        "enum": [
          "problem_identification",
          "evidence_extraction",
          "reasoning_chain",
          "hazard_chain",
          "uncertainty",
          "mitigation_match"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "student_id",
    "case_id",
    "material_kind",
    "stage",
    "paragraphs",
    "raw_analysis",
    "evidence_cards",
    "previous_issue_ids",
    "revisions",
    "report_scope",
    "assessed_dimensions"
  ],
  "additionalProperties": false
}
